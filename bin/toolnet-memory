    shift
    run bundle/code-capabilities.js src/code-intelligence/parsers/capability-cli.ts "$@"
    ;;

  task:list)
    shift
    run bundle/task-cli.js src/tasks/cli.ts list "$@"
    ;;
  task:show)
    shift
    run bundle/task-cli.js src/tasks/cli.ts show "$@"
    ;;
  task:create)
    shift
    run bundle/task-cli.js src/tasks/cli.ts create "$@"
    ;;
  task:update)
