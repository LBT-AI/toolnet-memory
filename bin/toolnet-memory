#!/usr/bin/env bash
set -e

SOURCE="${BASH_SOURCE[0]}"

while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done

ROOT="$(cd -P "$(dirname "$SOURCE")/.." >/dev/null 2>&1 && pwd)"
NODE="${NODE_BINARY:-node}"
TSX="$ROOT/node_modules/.bin/tsx"


if [ "${1:-}" = "--version" ] || [ "${1:-}" = "-v" ]; then
  node -e 'console.log("v" + require(process.argv[1]).version)' "$ROOT/package.json"
  exit 0
fi

COMMAND="${1:-context:print}"

run() {
  DIST="$1"
  SRC="$2"
  shift 2

  if [ -f "$ROOT/$DIST" ]; then
    exec "$NODE" "$ROOT/$DIST" "$@"
  fi

  # Development checkout fallback only.
  if [ -x "$TSX" ] && [ -f "$ROOT/$SRC" ]; then
    exec "$TSX" "$ROOT/$SRC" "$@"
  fi

  echo "ToolNet production build missing."
  echo "Run: npm run build:prod"
  exit 1
}

case "$COMMAND" in
  init)
    shift
    run bundle/init.js src/production/init.ts "$@"
    ;;

  ask)
    shift
    run bundle/memory-query.js src/work-continuity/memory-query-cli.ts "$@"
    ;;

  background:refresh)
    shift
    run bundle/background-refresh.js src/multi-host/background-refresh-cli.ts "$@"
    ;;

  handoff:refresh)
    shift
    run bundle/handoff-refresh.js src/work-continuity/handoff-cli.ts "$@"
    ;;

