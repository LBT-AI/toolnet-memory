#!/usr/bin/env bash
set -e

SOURCE="${BASH_SOURCE[0]}"

while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done

ROOT="$(cd -P "$(dirname "$SOURCE")/.." >/dev/null 2>&1 && pwd)"
NODE="${NODE_BINARY:-node}"
TSX="$ROOT/node_modules/.bin/tsx"


if [ "${1:-}" = "--version" ] || [ "${1:-}" = "-v" ]; then
  node -e 'console.log("v" + require(process.argv[1]).version)' "$ROOT/package.json"
  exit 0
fi

COMMAND="${1:-context:print}"

run() {
  DIST="$1"
  SRC="$2"
  shift 2

  if [ -f "$ROOT/$DIST" ]; then
    exec "$NODE" "$ROOT/$DIST" "$@"
  fi

  # Development checkout fallback only.
  if [ -x "$TSX" ] && [ -f "$ROOT/$SRC" ]; then
    exec "$TSX" "$ROOT/$SRC" "$@"
  fi

  echo "ToolNet production build missing."
  echo "Run: npm run build:prod"
  exit 1
}

case "$COMMAND" in
  init)
    shift
    run bundle/init.js src/production/init.ts "$@"
    ;;

  ask)
    shift
    run bundle/memory-query.js src/work-continuity/memory-query-cli.ts "$@"
    ;;

  background:refresh)
    shift
    run bundle/background-refresh.js src/multi-host/background-refresh-cli.ts "$@"
    ;;

  handoff:refresh)
    shift
    run bundle/handoff-refresh.js src/work-continuity/handoff-cli.ts "$@"
    ;;

  update)
    shift
    run bundle/update.js src/production/update.ts "$@"
    ;;

  config)
    shift
    run bundle/config.js src/production/config-cli.ts "$@"
    ;;

  doctor)
    shift
    run bundle/doctor.js src/production/doctor.ts "$@"
    ;;

  gc)
    shift
    run bundle/gc.js src/retention/cli.ts "$@"
    ;;
  audit)
    shift
    run bundle/audit.js src/audit/cli.ts "$@"
    ;;
  audit:verify)
    shift
    run bundle/audit.js src/audit/cli.ts verify "$@"
    ;;
  code:capabilities)
    shift
    run bundle/code-capabilities.js src/code-intelligence/parsers/capability-cli.ts "$@"
    ;;

  run)
    run bundle/runtime.js src/index.ts
    ;;

  mcp)
    run bundle/mcp.js src/mcp/bootstrap.ts
    ;;

  api)
    run bundle/api.js src/api/bootstrap.ts
    ;;

  service)
    shift
    run bundle/service.js src/service/daemon.ts "$@"
    ;;

  service:install)
    shift
    run bundle/service-cli.js src/service/cli.ts install "$@"
    ;;

  service:start)
    shift
    run bundle/service-cli.js src/service/cli.ts start "$@"
    ;;

  service:stop)
    shift
    run bundle/service-cli.js src/service/cli.ts stop "$@"
    ;;

  service:restart)
    shift
    run bundle/service-cli.js src/service/cli.ts restart "$@"
    ;;

  service:status)
    shift
    run bundle/service-cli.js src/service/cli.ts status "$@"
    ;;

  service:remove)
    shift
    run bundle/service-cli.js src/service/cli.ts remove "$@"
    ;;

  production:certify)
    run bundle/production-certify.js src/production/production-certify-cli.ts
    ;;

  index)
    run bundle/full-index.js src/production/full-index.ts
    ;;

  index:graph)
    run bundle/graph-index.js src/code-intelligence/test-index.ts
    ;;

  incremental)
    run bundle/incremental.js src/code-intelligence/test-incremental.ts
    ;;

  semantic)
    shift
    run bundle/semantic.js src/code-intelligence/test-semantic.ts "$@"
    ;;

  impact)
    shift
    run bundle/impact.js src/code-intelligence/test-impact.ts "$@"
    ;;

  snapshot:list)
    run bundle/snapshot.js src/production/snapshot-cli.ts list
    ;;

  snapshot:create)
    shift
    run bundle/snapshot.js src/production/snapshot-cli.ts create "$@"
    ;;

  snapshot:restore)
    shift
    run bundle/snapshot.js src/production/snapshot-cli.ts restore "$@"
    ;;

  recover)
    run bundle/snapshot.js src/production/snapshot-cli.ts recover-latest
    ;;

  session:opencode-sync)
    shift

    if [ -f "$ROOT/bundle/opencode.js" ]; then
      exec node "$ROOT/bundle/opencode.js" sync "$@"
    fi

    if [ -n "${TSX:-}" ] && [ -x "${TSX:-}" ]; then
      exec "$TSX" "$ROOT/src/session/opencode/cli.ts" sync "$@"
    fi

    echo "OpenCode session adapter not found."
    exit 1
    ;;

  session:opencode-recover)
    shift

    if [ -f "$ROOT/bundle/opencode.js" ]; then
      exec node "$ROOT/bundle/opencode.js" recover "$@"
    fi

    if [ -n "${TSX:-}" ] && [ -x "${TSX:-}" ]; then
      exec "$TSX" "$ROOT/src/session/opencode/cli.ts" recover "$@"
    fi

    echo "OpenCode session adapter not found."
    exit 1
    ;;

  integrate:detect)
    shift
    run bundle/auto-integrate.js src/production/auto-integrate.ts --detect-only "$@"
    ;;

  integrate:auto)
    shift
    run bundle/auto-integrate.js src/production/auto-integrate.ts "$@"
    ;;

  integrate:opencode)
    shift

    if [ -f "$ROOT/bundle/opencode.js" ]; then
      exec node "$ROOT/bundle/opencode.js" install-plugin "$@"
    fi

    if [ -n "${TSX:-}" ] && [ -x "${TSX:-}" ]; then
      exec "$TSX" "$ROOT/src/session/opencode/cli.ts" install-plugin "$@"
    fi

    echo "OpenCode plugin installer not found."
    exit 1
    ;;

  session:agy-hook)
    shift

    if [ -f "$ROOT/bundle/agy-hook.js" ]; then
      exec node "$ROOT/bundle/agy-hook.js" "$@"
    fi

    if [ -x "${TSX:-}" ] && [ -f "$ROOT/src/session/agy/hook.ts" ]; then
      exec "$TSX" "$ROOT/src/session/agy/hook.ts" "$@"
    fi

    exit 0
    ;;

  session:agy-sync)
    shift

    if [ -f "$ROOT/bundle/agy.js" ]; then
      exec node "$ROOT/bundle/agy.js" sync "$@"
    fi

    exec "$TSX" "$ROOT/src/session/agy/cli.ts" sync "$@"
    ;;

  session:agy-recover)
    shift

    if [ -f "$ROOT/bundle/agy.js" ]; then
      exec node "$ROOT/bundle/agy.js" recover "$@"
    fi

    exec "$TSX" "$ROOT/src/session/agy/cli.ts" recover "$@"
    ;;

  integrate:agy)
    shift

    if [ -f "$ROOT/bundle/agy.js" ]; then
      exec node "$ROOT/bundle/agy.js" install-hooks "$@"
    fi

    exec "$TSX" "$ROOT/src/session/agy/cli.ts" install-hooks "$@"
    ;;

  certify:continuity)
    shift

    if [ -f "$ROOT/bundle/continuity-certify.js" ]; then
      exec node "$ROOT/bundle/continuity-certify.js" "$@"
    fi

    if [ -x "${TSX:-}" ] && [ -f "$ROOT/src/production/continuity-certify-cli.ts" ]; then
      exec "$TSX" "$ROOT/src/production/continuity-certify-cli.ts" "$@"
    fi

    echo "Continuity certification runtime not found."
    exit 1
    ;;

  session:claude-hook)
    shift

    if [ -f "$ROOT/bundle/claude-hook.js" ]; then
      exec node "$ROOT/bundle/claude-hook.js" "$@"
    fi

    if [ -x "${TSX:-}" ] && [ -f "$ROOT/src/session/claude/hook.ts" ]; then
      exec "$TSX" "$ROOT/src/session/claude/hook.ts" "$@"
    fi

    exit 0
    ;;

  session:kiro-hook)
    shift

    if [ -f "$ROOT/bundle/kiro-hook.js" ]; then
      exec node "$ROOT/bundle/kiro-hook.js" "$@"
    fi

    if [ -x "${TSX:-}" ] && [ -f "$ROOT/src/session/kiro/hook.ts" ]; then
      exec "$TSX" "$ROOT/src/session/kiro/hook.ts" "$@"
    fi

    exit 0
    ;;

  session:cursor-hook)
    shift
    if [ -f "$ROOT/bundle/cursor-hook.js" ]; then
      exec node "$ROOT/bundle/cursor-hook.js" "$@"
    fi
    if [ -x "${TSX:-}" ] && [ -f "$ROOT/src/session/cursor/hook.ts" ]; then
      exec "$TSX" "$ROOT/src/session/cursor/hook.ts" "$@"
    fi
    exit 0
    ;;

  session:copilot-hook)
    shift
    if [ -f "$ROOT/bundle/copilot-hook.js" ]; then
      exec node "$ROOT/bundle/copilot-hook.js" "$@"
    fi
    if [ -x "${TSX:-}" ] && [ -f "$ROOT/src/session/copilot/hook.ts" ]; then
      exec "$TSX" "$ROOT/src/session/copilot/hook.ts" "$@"
    fi
    exit 0
    ;;

  session:grok-hook)
    shift
    if [ -f "$ROOT/bundle/grok-hook.js" ]; then
      exec node "$ROOT/bundle/grok-hook.js" "$@"
    fi
    if [ -x "${TSX:-}" ] && [ -f "$ROOT/src/session/grok/hook.ts" ]; then
      exec "$TSX" "$ROOT/src/session/grok/hook.ts" "$@"
    fi
    exit 0
    ;;

  integrate:claude)
    shift

    if [ -f "$ROOT/bundle/claude.js" ]; then
      exec node "$ROOT/bundle/claude.js" install "$@"
    fi

    if [ -x "${TSX:-}" ] && [ -f "$ROOT/src/session/claude/cli.ts" ]; then
      exec "$TSX" "$ROOT/src/session/claude/cli.ts" install "$@"
    fi

    echo "Claude Code integration installer not found."
    exit 1
    ;;

  integrate:kiro)
    shift

    if [ -f "$ROOT/bundle/kiro.js" ]; then
      exec node "$ROOT/bundle/kiro.js" install "$@"
    fi

    if [ -x "${TSX:-}" ] && [ -f "$ROOT/src/session/kiro/cli.ts" ]; then
      exec "$TSX" "$ROOT/src/session/kiro/cli.ts" install "$@"
    fi

    echo "Kiro CLI integration installer not found."
    exit 1
    ;;

  integrate:cursor)
    shift
    run bundle/cursor.js src/session/cursor/cli.ts "$@"
    ;;

  integrate:copilot)
    shift
    run bundle/copilot.js src/session/copilot/cli.ts "$@"
    ;;

  integrate:grok)
    shift
    run bundle/grok.js src/session/grok/cli.ts "$@"
    ;;

  integrate:toolnet-cli)
    shift
    run bundle/toolnet-cli.js src/session/toolnet-cli/cli.ts "$@"
    ;;

  integrate:kilo)
    shift
    run bundle/kilo.js src/session/kilo/cli.ts "$@"
    ;;

  integrate:all)
    shift
    run bundle/auto-integrate.js src/production/auto-integrate.ts "$@"
    ;;

  integrate:status)
    shift
    run bundle/integration-status.js src/session/new-agents/scoped-status-cli.ts "$@"
    ;;

  session:codex-notify)
    shift

    if [ -f "$ROOT/bundle/codex.js" ]; then
      exec node "$ROOT/bundle/codex.js" notify "$@"
    fi

    if [ -x "${TSX:-}" ]; then
      exec "$TSX" "$ROOT/src/session/codex/cli.ts" notify "$@"
    fi

    exit 0
    ;;

  session:codex-sync)
    shift

    if [ -f "$ROOT/bundle/codex.js" ]; then
      exec node "$ROOT/bundle/codex.js" sync "$@"
    fi

    exec "$TSX" "$ROOT/src/session/codex/cli.ts" sync "$@"
    ;;

  session:codex-recover)
    shift

    if [ -f "$ROOT/bundle/codex.js" ]; then
      exec node "$ROOT/bundle/codex.js" recover "$@"
    fi

    exec "$TSX" "$ROOT/src/session/codex/cli.ts" recover "$@"
    ;;

  integrate:codex)
    shift

    if [ -f "$ROOT/bundle/codex.js" ]; then
      exec node "$ROOT/bundle/codex.js" install-notify "$@"
    fi

    exec "$TSX" "$ROOT/src/session/codex/cli.ts" install-notify "$@"
    ;;

  memory:reconcile)
    shift

    if [ -f "$ROOT/bundle/learner.js" ]; then
      exec node "$ROOT/bundle/learner.js" reconcile "$@"
    fi

    if [ -x "${TSX:-}" ]; then
      exec "$TSX" "$ROOT/src/session/learner/cli.ts" reconcile "$@"
    fi

    echo "Memory learner not found."
    exit 1
    ;;

  memory:review)
    shift

    if [ -x "${TSX:-}" ]; then
      exec "$TSX" "$ROOT/src/session/memory-review-cli.ts" "$@"
    fi

    echo "Memory review not available."
    exit 1
    ;;

  guard:check)
    shift

    if [ -x "${TSX:-}" ]; then
      exec "$TSX" "$ROOT/src/guard/cli.ts" "$@"
    fi

    echo "Guard not available."
    exit 1
    ;;

  guard:explain)
    shift

    if [ -x "${TSX:-}" ]; then
      exec "$TSX" "$ROOT/src/guard/cli.ts" "$@"
    fi

    echo "Guard not available."
    exit 1
    ;;

  guard:json)
    shift

    if [ -x "${TSX:-}" ]; then
      exec "$TSX" "$ROOT/src/guard/cli.ts" --json "$@"
    fi

    echo "Guard not available."
    exit 1
    ;;

  project:manual-init)
    shift

    if [ -f "$ROOT/bundle/project-manual.js" ]; then
      exec node "$ROOT/bundle/project-manual.js" init "$@"
    fi

    exec "$TSX" "$ROOT/src/project-manual/cli.ts" init "$@"
    ;;

  project:manual-show)
    shift

    if [ -f "$ROOT/bundle/project-manual.js" ]; then
      exec node "$ROOT/bundle/project-manual.js" show "$@"
    fi

    exec "$TSX" "$ROOT/src/project-manual/cli.ts" show "$@"
    ;;

  project:manual-sync)
    shift

    if [ -f "$ROOT/bundle/project-manual.js" ]; then
      exec node "$ROOT/bundle/project-manual.js" sync "$@"
    fi

    exec "$TSX" "$ROOT/src/project-manual/cli.ts" sync "$@"
    ;;

  work:status)
    shift

    if [ -f "$ROOT/bundle/work-continuity.js" ]; then
      exec node "$ROOT/bundle/work-continuity.js" status "$@"
    fi

    exec "$TSX" "$ROOT/src/work-continuity/cli.ts" status "$@"
    ;;

  work:json)
    shift

    if [ -f "$ROOT/bundle/work-continuity.js" ]; then
      exec node "$ROOT/bundle/work-continuity.js" json "$@"
    fi

    exec "$TSX" "$ROOT/src/work-continuity/cli.ts" json "$@"
    ;;

  work:reconcile)
    shift

    if [ -f "$ROOT/bundle/work-continuity.js" ]; then
      exec node "$ROOT/bundle/work-continuity.js" reconcile "$@"
    fi

    exec "$TSX" "$ROOT/src/work-continuity/cli.ts" reconcile "$@"
    ;;

  brief)
    shift

    if [ -f "$ROOT/bundle/context.js" ]; then
      exec node "$ROOT/bundle/context.js" brief "$@"
    fi

    exec "$TSX" "$ROOT/src/work-continuity/context-cli.ts" brief "$@"
    ;;

  brief:json)
    shift

    if [ -f "$ROOT/bundle/context.js" ]; then
      exec node "$ROOT/bundle/context.js" brief-json "$@"
    fi

    exec "$TSX" "$ROOT/src/work-continuity/context-cli.ts" brief-json "$@"
    ;;

  handoff:latest)
    shift

    if [ -f "$ROOT/bundle/context.js" ]; then
      exec node "$ROOT/bundle/context.js" handoff-latest "$@"
    fi

    exec "$TSX" "$ROOT/src/work-continuity/context-cli.ts" handoff-latest "$@"
    ;;

  context:sync)
    shift

    if [ -f "$ROOT/bundle/context-runtime.js" ]; then
      exec node "$ROOT/bundle/context-runtime.js" sync "$@"
    fi

    exec "$TSX" "$ROOT/src/work-continuity/context-runtime-cli.ts" sync "$@"
    ;;

  context:print)
    shift

    if [ -f "$ROOT/bundle/context-runtime.js" ]; then
      exec node "$ROOT/bundle/context-runtime.js" print "$@"
    fi

    exec "$TSX" "$ROOT/src/work-continuity/context-runtime-cli.ts" print "$@"
    ;;

  context:refresh)
    shift

    if [ -f "$ROOT/bundle/context-runtime.js" ]; then
      exec node "$ROOT/bundle/context-runtime.js" refresh "$@"
    fi

    exec "$TSX" "$ROOT/src/work-continuity/context-runtime-cli.ts" refresh "$@"
    ;;

  profile:show)
    shift

    if [ -f "$ROOT/bundle/context-runtime.js" ]; then
      exec node "$ROOT/bundle/context-runtime.js" profile-show "$@"
    fi

    exec "$TSX" "$ROOT/src/work-continuity/context-runtime-cli.ts" profile-show "$@"
    ;;

  profile:sync)
    shift

    if [ -f "$ROOT/bundle/context-runtime.js" ]; then
      exec node "$ROOT/bundle/context-runtime.js" profile-sync "$@"
    fi

    exec "$TSX" "$ROOT/src/work-continuity/context-runtime-cli.ts" profile-sync "$@"
    ;;

  session:codex-context)
    shift

    if [ -f "$ROOT/bundle/codex-context.js" ]; then
      exec node "$ROOT/bundle/codex-context.js" "$@"
    fi

    if [ -x "${TSX:-}" ] && [ -f "$ROOT/src/session/codex/context-hook.ts" ]; then
      exec "$TSX" "$ROOT/src/session/codex/context-hook.ts" "$@"
    fi

    exit 0
    ;;

  help|--help|-h)
    shift
    run bundle/help-cli.js src/production/help-cli.ts "$@"
    ;;

  # Aliases
  context)
    shift
    run bundle/context-runtime.js src/work-continuity/context-runtime-cli.ts print "$@"
    ;;

  work)
    shift
    if [ -f "$ROOT/bundle/work-continuity.js" ]; then
      exec node "$ROOT/bundle/work-continuity.js" status "$@"
    fi
    exec "$TSX" "$ROOT/src/work-continuity/cli.ts" status "$@"
    ;;

  graph)
    shift
    run bundle/graph-cli.js src/production/graph-cli.ts "$@"
    ;;

  graph:ui)
    shift
    run bundle/graph-cli.js src/production/graph-cli.ts "$@"
    ;;

  status)
    shift
    run bundle/status-cli.js src/production/status-cli.ts "$@"
    ;;


  *)
    run bundle/help-cli.js src/production/help-cli.ts --unknown "$COMMAND"
    ;;

esac
