#!/usr/bin/env bash
set -e

SOURCE="${BASH_SOURCE[0]}"

while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done

ROOT="$(cd -P "$(dirname "$SOURCE")/.." >/dev/null 2>&1 && pwd)"
NODE="${NODE_BINARY:-node}"
TSX="$ROOT/node_modules/.bin/tsx"


if [ "${1:-}" = "--version" ] || [ "${1:-}" = "-v" ]; then
  node -e 'console.log("v" + require(process.argv[1]).version)' "$ROOT/package.json"
  exit 0
fi

COMMAND="${1:-context:print}"

run() {
  DIST="$1"
  SRC="$2"
  shift 2

  if [ -f "$ROOT/$DIST" ]; then
    exec "$NODE" "$ROOT/$DIST" "$@"
  fi

  # Development checkout fallback only.
  if [ -x "$TSX" ] && [ -f "$ROOT/$SRC" ]; then
    exec "$TSX" "$ROOT/$SRC" "$@"
  fi

  echo "ToolNet production build missing."
  echo "Run: npm run build:prod"
  exit 1
}

case "$COMMAND" in
  update)
    shift
    run bundle/update.js src/production/update.ts "$@"
    ;;

  config)
    shift
    run bundle/config.js src/production/config-cli.ts "$@"
    ;;

  setup)
    if [ -f "$ROOT/bundle/setup.js" ]; then
      exec node "$ROOT/bundle/setup.js" "$@"
    elif [ -f "$ROOT/src/production/setup.ts" ]; then
      exec npx --yes tsx "$ROOT/src/production/setup.ts" "$@"
    else
      echo "ToolNet setup module missing."
      exit 1
    fi
    ;;


  doctor)
    shift
    run bundle/doctor.js src/production/doctor.ts "$@"
    ;;

  run)
    run bundle/runtime.js src/index.ts
    ;;

  mcp)
    run bundle/mcp.js src/mcp/bootstrap.ts
    ;;

  index)
    run bundle/full-index.js src/production/full-index.ts
    ;;

  index:graph)
    run bundle/graph-index.js src/code-intelligence/test-index.ts
    ;;

  incremental)
    run bundle/incremental.js src/code-intelligence/test-incremental.ts
    ;;

  semantic)
    shift
    run bundle/semantic.js src/code-intelligence/test-semantic.ts "$@"
    ;;

  impact)
    shift
    run bundle/impact.js src/code-intelligence/test-impact.ts "$@"
    ;;

  snapshot:list)
    run bundle/snapshot.js src/production/snapshot-cli.ts list
    ;;

  snapshot:create)
    shift
    run bundle/snapshot.js src/production/snapshot-cli.ts create "$@"
    ;;

  snapshot:restore)
    shift
    run bundle/snapshot.js src/production/snapshot-cli.ts restore "$@"
    ;;

  recover)
    run bundle/snapshot.js src/production/snapshot-cli.ts recover-latest
    ;;

  session:opencode-sync)
    shift

    if [ -f "$ROOT/bundle/opencode.js" ]; then
      exec node "$ROOT/bundle/opencode.js" sync "$@"
    fi

    if [ -n "${TSX:-}" ] && [ -x "${TSX:-}" ]; then
      exec "$TSX" "$ROOT/src/session/opencode/cli.ts" sync "$@"
    fi

    echo "OpenCode session adapter not found."
    exit 1
    ;;

  session:opencode-recover)
    shift

    if [ -f "$ROOT/bundle/opencode.js" ]; then
      exec node "$ROOT/bundle/opencode.js" recover "$@"
    fi

    if [ -n "${TSX:-}" ] && [ -x "${TSX:-}" ]; then
      exec "$TSX" "$ROOT/src/session/opencode/cli.ts" recover "$@"
    fi

    echo "OpenCode session adapter not found."
    exit 1
    ;;

  integrate:auto)
    shift
    run bundle/auto-integrate.js src/production/auto-integrate.ts "$@"
    ;;

  integrate:opencode)
    shift

    if [ -f "$ROOT/bundle/opencode.js" ]; then
      exec node "$ROOT/bundle/opencode.js" install-plugin "$@"
    fi

    if [ -n "${TSX:-}" ] && [ -x "${TSX:-}" ]; then
      exec "$TSX" "$ROOT/src/session/opencode/cli.ts" install-plugin "$@"
    fi

    echo "OpenCode plugin installer not found."
    exit 1
    ;;

  session:agy-hook)
    shift

    if [ -f "$ROOT/bundle/agy-hook.js" ]; then
      exec node "$ROOT/bundle/agy-hook.js" "$@"
    fi

    if [ -x "${TSX:-}" ] && [ -f "$ROOT/src/session/agy/hook.ts" ]; then
      exec "$TSX" "$ROOT/src/session/agy/hook.ts" "$@"
    fi

    exit 0
    ;;

  session:agy-sync)
    shift

    if [ -f "$ROOT/bundle/agy.js" ]; then
      exec node "$ROOT/bundle/agy.js" sync "$@"
    fi

    exec "$TSX" "$ROOT/src/session/agy/cli.ts" sync "$@"
    ;;

  session:agy-recover)
    shift

    if [ -f "$ROOT/bundle/agy.js" ]; then
      exec node "$ROOT/bundle/agy.js" recover "$@"
    fi

    exec "$TSX" "$ROOT/src/session/agy/cli.ts" recover "$@"
    ;;

  integrate:agy)
    shift

    if [ -f "$ROOT/bundle/agy.js" ]; then
      exec node "$ROOT/bundle/agy.js" install-hooks "$@"
    fi

    exec "$TSX" "$ROOT/src/session/agy/cli.ts" install-hooks "$@"
    ;;

  session:codex-notify)
    shift

    if [ -f "$ROOT/bundle/codex.js" ]; then
      exec node "$ROOT/bundle/codex.js" notify "$@"
    fi

    if [ -x "${TSX:-}" ]; then
      exec "$TSX" "$ROOT/src/session/codex/cli.ts" notify "$@"
    fi

    exit 0
    ;;

  session:codex-sync)
    shift

    if [ -f "$ROOT/bundle/codex.js" ]; then
      exec node "$ROOT/bundle/codex.js" sync "$@"
    fi

    exec "$TSX" "$ROOT/src/session/codex/cli.ts" sync "$@"
    ;;

  session:codex-recover)
    shift

    if [ -f "$ROOT/bundle/codex.js" ]; then
      exec node "$ROOT/bundle/codex.js" recover "$@"
    fi

    exec "$TSX" "$ROOT/src/session/codex/cli.ts" recover "$@"
    ;;

  integrate:codex)
    shift

    if [ -f "$ROOT/bundle/codex.js" ]; then
      exec node "$ROOT/bundle/codex.js" install-notify "$@"
    fi

    exec "$TSX" "$ROOT/src/session/codex/cli.ts" install-notify "$@"
    ;;

  memory:reconcile)
    shift

    if [ -f "$ROOT/bundle/learner.js" ]; then
      exec node "$ROOT/bundle/learner.js" reconcile "$@"
    fi

    if [ -x "${TSX:-}" ]; then
      exec "$TSX" "$ROOT/src/session/learner/cli.ts" reconcile "$@"
    fi

    echo "Memory learner not found."
    exit 1
    ;;

  memory:review)
    shift

    if [ -x "${TSX:-}" ]; then
      exec "$TSX" "$ROOT/src/session/memory-review-cli.ts" "$@"
    fi

    echo "Memory review not available."
    exit 1
    ;;

  project:manual-init)
    shift

    if [ -f "$ROOT/bundle/project-manual.js" ]; then
      exec node "$ROOT/bundle/project-manual.js" init "$@"
    fi

    exec "$TSX" "$ROOT/src/project-manual/cli.ts" init "$@"
    ;;

  project:manual-show)
    shift

    if [ -f "$ROOT/bundle/project-manual.js" ]; then
      exec node "$ROOT/bundle/project-manual.js" show "$@"
    fi

    exec "$TSX" "$ROOT/src/project-manual/cli.ts" show "$@"
    ;;

  project:manual-sync)
    shift

    if [ -f "$ROOT/bundle/project-manual.js" ]; then
      exec node "$ROOT/bundle/project-manual.js" sync "$@"
    fi

    exec "$TSX" "$ROOT/src/project-manual/cli.ts" sync "$@"
    ;;

  work:status)
    shift

    if [ -f "$ROOT/bundle/work-continuity.js" ]; then
      exec node "$ROOT/bundle/work-continuity.js" status "$@"
    fi

    exec "$TSX" "$ROOT/src/work-continuity/cli.ts" status "$@"
    ;;

  work:json)
    shift

    if [ -f "$ROOT/bundle/work-continuity.js" ]; then
      exec node "$ROOT/bundle/work-continuity.js" json "$@"
    fi

    exec "$TSX" "$ROOT/src/work-continuity/cli.ts" json "$@"
    ;;

  work:reconcile)
    shift

    if [ -f "$ROOT/bundle/work-continuity.js" ]; then
      exec node "$ROOT/bundle/work-continuity.js" reconcile "$@"
    fi

    exec "$TSX" "$ROOT/src/work-continuity/cli.ts" reconcile "$@"
    ;;

  brief)
    shift

    if [ -f "$ROOT/bundle/context.js" ]; then
      exec node "$ROOT/bundle/context.js" brief "$@"
    fi

    exec "$TSX" "$ROOT/src/work-continuity/context-cli.ts" brief "$@"
    ;;

  brief:json)
    shift

    if [ -f "$ROOT/bundle/context.js" ]; then
      exec node "$ROOT/bundle/context.js" brief-json "$@"
    fi

    exec "$TSX" "$ROOT/src/work-continuity/context-cli.ts" brief-json "$@"
    ;;

  handoff:latest)
    shift

    if [ -f "$ROOT/bundle/context.js" ]; then
      exec node "$ROOT/bundle/context.js" handoff-latest "$@"
    fi

    exec "$TSX" "$ROOT/src/work-continuity/context-cli.ts" handoff-latest "$@"
    ;;

  context:sync)
    shift

    if [ -f "$ROOT/bundle/context-runtime.js" ]; then
      exec node "$ROOT/bundle/context-runtime.js" sync "$@"
    fi

    exec "$TSX" "$ROOT/src/work-continuity/context-runtime-cli.ts" sync "$@"
    ;;

  context:print)
    shift

    if [ -f "$ROOT/bundle/context-runtime.js" ]; then
      exec node "$ROOT/bundle/context-runtime.js" print "$@"
    fi

    exec "$TSX" "$ROOT/src/work-continuity/context-runtime-cli.ts" print "$@"
    ;;

  context:refresh)
    shift

    if [ -f "$ROOT/bundle/context-runtime.js" ]; then
      exec node "$ROOT/bundle/context-runtime.js" refresh "$@"
    fi

    exec "$TSX" "$ROOT/src/work-continuity/context-runtime-cli.ts" refresh "$@"
    ;;

  profile:show)
    shift

    if [ -f "$ROOT/bundle/context-runtime.js" ]; then
      exec node "$ROOT/bundle/context-runtime.js" profile-show "$@"
    fi

    exec "$TSX" "$ROOT/src/work-continuity/context-runtime-cli.ts" profile-show "$@"
    ;;

  profile:sync)
    shift

    if [ -f "$ROOT/bundle/context-runtime.js" ]; then
      exec node "$ROOT/bundle/context-runtime.js" profile-sync "$@"
    fi

    exec "$TSX" "$ROOT/src/work-continuity/context-runtime-cli.ts" profile-sync "$@"
    ;;

  session:codex-context)
    shift

    if [ -f "$ROOT/bundle/codex-context.js" ]; then
      exec node "$ROOT/bundle/codex-context.js" "$@"
    fi

    if [ -x "${TSX:-}" ] && [ -f "$ROOT/src/session/codex/context-hook.ts" ]; then
      exec "$TSX" "$ROOT/src/session/codex/context-hook.ts" "$@"
    fi

    exit 0
    ;;

  help|--help|-h)
    cat <<'HELP'
ToolNet Memory - Project Context & Memory System

FAST CONTEXT (default):
  toolnet-memory                          Print fast project context (default)
  toolnet-memory context:print            Print fast project context
  toolnet-memory context:sync             Show context hash/size
  toolnet-memory profile:show             Show .toolnet/profile.md
  toolnet-memory profile:sync             Sync profile to GEMINI.md/AGENTS.md/CLAUDE.md

MANUAL DEEP RECOVERY (do not run automatically):
  toolnet-memory context:refresh          Rebuild deep startup brief cache
  toolnet-memory brief [--tokens N]       Show full project brief
  toolnet-memory handoff:latest           Show latest session handoff
  toolnet-memory session:agy-recover [--limit N]      Recover Agy sessions
  toolnet-memory session:codex-recover [--limit N]    Recover Codex sessions
  toolnet-memory session:opencode-recover [--limit N] Recover OpenCode sessions

MEMORY OPERATIONS:
  toolnet-memory memory:review [--project PATH] [--session ID]
  toolnet-memory memory:reconcile [--project PATH]

NOTE: Raw transcripts are not injected into prompts.
      Durable memory is promoted selectively based on importance scoring.

PROJECT MANUAL:
  toolnet-memory project:manual-init [--project PATH]
  toolnet-memory project:manual-show [--project PATH]
  toolnet-memory project:manual-sync [--project PATH]

WORK CONTINUITY:
  toolnet-memory work:status [--project PATH]
  toolnet-memory work:json [--project PATH]
  toolnet-memory work:reconcile [--project PATH]

CODE INTELLIGENCE:
  toolnet-memory index
  toolnet-memory index:graph
  toolnet-memory incremental
  toolnet-memory semantic "query"
  toolnet-memory impact [file]

SETUP & INTEGRATION:
  toolnet-memory --version
  toolnet-memory doctor
  toolnet-memory setup
  toolnet-memory update
  toolnet-memory config get KEY
  toolnet-memory config set KEY VALUE
  toolnet-memory config open
  toolnet-memory integrate:auto
  toolnet-memory integrate:opencode
  toolnet-memory integrate:agy
  toolnet-memory integrate:codex
  toolnet-memory mcp

SNAPSHOTS:
  toolnet-memory snapshot:list
  toolnet-memory snapshot:create "reason"
  toolnet-memory snapshot:restore <id>
  toolnet-memory recover

SESSION SYNC (manual):
  toolnet-memory session:agy-sync <conversation-id> --transcript <path>
  toolnet-memory session:codex-sync <thread-id>
  toolnet-memory session:opencode-sync <session-id>

IMPORTANT:
Deep recovery commands (brief, handoff:latest, session:*-recover) are manual only.
Do not run them automatically at startup. Use fast context commands instead.
HELP
    ;;

  *)
    echo "Unknown command: $COMMAND"
    echo "Run: toolnet-memory help"
    exit 1
    ;;
esac
