{
  "schemaVersion": 1,
  "name": "toolnet-memory",
  "version": "0.3.16",
  "releaseSeries": "0.3.x",
  "runtime": {
    "node": ">=22",
    "localMemoryRuntime": true,
    "requiresLlm": false,
    "requiresEmbeddings": false,
    "retrieval": ["BM25", "SQLite FTS5"],
    "sharedProjectMemory": true,
    "multiHostConvergence": true,
    "storageImplementationFrozen": true
  },
  "continuity": {
    "sharedJournal": ".toolnet/journal/events.jsonl",
    "runtimeProvenance": ".toolnet/runtime/sources",
    "legacySessionsWrite": false,
    "appendOnlyRemoteOperations": true,
    "deterministicProjection": true,
    "crashRecovery": true
  },
  "agents": {
    "agy": {
      "displayName": "Agy / Antigravity",
      "refreshMode": "native-lifecycle"
    },
    "opencode": {
      "displayName": "OpenCode",
      "refreshMode": "persistent-plugin"
    },
    "codex": {
      "displayName": "Codex",
      "refreshMode": "native-lifecycle"
    },
    "claude": {
      "displayName": "Claude Code",
      "refreshMode": "native-lifecycle"
    },
    "kiro": {
      "displayName": "Kiro CLI",
      "refreshMode": "native-lifecycle"
    },
    "cursor": {
      "displayName": "Cursor CLI",
      "refreshMode": "native-lifecycle"
    },
    "copilot": {
      "displayName": "GitHub Copilot CLI",
      "refreshMode": "native-lifecycle"
    },
    "grok": {
      "displayName": "Grok Build",
      "refreshMode": "native-lifecycle"
    },
    "toolnet-cli": {
      "displayName": "ToolNet CLI",
      "refreshMode": "native-session"
    },
    "kilo": {
      "displayName": "Kilo",
      "refreshMode": "mcp-only"
    }
  },
  "releasePolicy": {
    "nativeCliE2ERequired": false,
    "nativeCliE2EReason": "Native host binaries are optional and may be unavailable on the certification host.",
    "fullRepositoryCertificationRequired": true,
    "npmPublishAutomatic": true,
    "gitTagAutomatic": false,
    "npmPublishTrigger": "git-tag-workflow-trusted-publishing"
  },
  "hardening": {
    "retention": {
      "safeGc": true,
      "defaultDryRun": true,
      "realDeleteRequiresApply": true,
      "protectSemanticMemory": true,
      "protectWorkCurrent": true,
      "protectSharedJournal": true,
      "protectRemoteOperations": true,
      "unflushedWalDeletion": false
    },
    "dedupe": {
      "projectScoped": true,
      "crossProcess": true,
      "crossContainerSharedVolume": true,
      "usesPidIdentity": false,
      "atomicExclusiveClaim": true,
      "ownershipToken": true,
      "ttlRecovery": true,
      "remoteDistributedLock": false
    },
    "largeRepository": {
      "benchmarkProfiles": ["10k", "50k", "100k"],
      "maxCodeFileBytes": 2097152,
      "symlinkTraversal": false,
      "boundedParseConcurrency": true,
      "boundedHashConcurrency": true,
      "cancellationBoundary": true,
      "renameDetection": "unique-hash-1to1"
    },
    "codeIntelligence": {
      "parserEngine": "typescript-compiler-api",
      "treeSitterRuntime": false,
      "supportedExtensions": [".ts", ".tsx", ".js", ".jsx", ".mts", ".cts", ".mjs", ".cjs"],
      "tsconfigPaths": true,
      "baseUrlResolution": true,
      "projectReferences": true,
      "workspacePackages": true,
      "graphRepair": true,
      "danglingEdgeProtection": true
    },
    "security": {
      "secretScannerVersion": 2,
      "durableSanitization": true,
      "projectIsolation": true,
      "projectDataTrusted": false,
      "clientSideEncryption": false,
      "requiresEncryptionKey": false
    },
    "projectIdentity": {
      "crossMachine": true,
      "existingManifestCanonical": true,
      "normalizedGitRemote": true,
      "sshHttpsEquivalent": true,
      "remoteIdentityRegistry": true,
      "legacyExplicitAdoption": true,
      "silentUnverifiedAdoption": false,
      "pathHashPrimaryForGit": false,
      "credentialLeakIntoFingerprint": false
    },
    "repositoryTruth": {
      "deadScaffoldsRemoved": true,
      "unsupportedCapabilitiesExplicit": true,
      "legacySyncScaffoldRemoved": true,
      "multiHostReplacement": "src/multi-host",
      "unclassifiedZeroByteSourceFiles": 0,
      "storagePlaceholdersFrozen": true
    },
    "codeSearch": {
      "displayName": "Local Code Search — SQLite FTS5/BM25",
      "engine": "sqlite-fts5-bm25",
      "mode": "lexical",
      "embeddings": false,
      "vectorDatabase": false,
      "networkRequired": false,
      "legacySemanticAliasesPreserved": true
    },
    "documentationTruth": {
      "runtimeCapabilityMatrix": true,
      "unsupportedLanguagesExplicit": true,
      "unsupportedStorageExplicit": true,
      "crossMachineIdentityDocumented": true,
      "multiHostArchitectureDocumented": true,
      "clientEncryptionClaimed": false
    },
    "conflictEngineV2": {
      "deterministic": true,
      "llmMerge": false,
      "embeddingMatching": false,
      "kinds": ["rule", "decision", "todo", "next_action", "fix", "context", "architecture"],
      "topicMatching": true,
      "entityMatching": true,
      "lexicalSubjectMatching": true,
      "verifiedFixCompletesTask": true,
      "verifiedFixResolvesContext": true,
      "conflictingMemoryActive": false,
      "completedMemoryActive": false,
      "resolvedMemoryActive": false
    }
  }
}
