{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "packages/sdk",
    "outDir": "dist/sdk",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": ["packages/sdk/public.ts", "packages/sdk/remote-client.ts", "packages/sdk/types.ts"]
}
